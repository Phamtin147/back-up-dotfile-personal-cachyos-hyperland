[Unit]
Description=Ryoku workspace compact daemon (Niri-style dynamic workspaces)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /home/amtia/.local/bin/ryoku-ws-compact
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
