#!/usr/bin/env bash
# Native Grim + Slurp screenshot script (100% Niri style)

DIR="$HOME/Pictures/screenshots"
mkdir -p "$DIR"
TIMESTAMP=$(date +"%Y%m%d_%H%M%S")
FILE="$DIR/${TIMESTAMP}.png"

MODE="${1:-area}"

case "$MODE" in
    full)
        grim "$FILE" || exit 1
        ;;
    window)
        # Capture focused window
        GEOM=$(hyprctl -j activewindow | jq -r '"\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"')
        if [ -n "$GEOM" ] && [ "$GEOM" != "null" ]; then
            grim -g "$GEOM" "$FILE" || exit 1
        else
            grim "$FILE" || exit 1
        fi
        ;;
    area|*)
        GEOM=$(slurp -b "#00000088" -c "#88c0d0ff" -w 2 2>/dev/null) || exit 0
        [ -n "$GEOM" ] || exit 0
        grim -g "$GEOM" "$FILE" || exit 1
        ;;
esac

if [ -s "$FILE" ]; then
    wl-copy < "$FILE"
    notify-send -a "Screenshot" -i "$FILE" "Đã chụp màn hình" "Đã lưu vào $FILE và sao chép vào Clipboard"
fi
