#!/usr/bin/env python3
import subprocess
import json
import sys

def kill_clean():
    try:
        raw = subprocess.check_output(["hyprctl", "activewindow", "-j"], stderr=subprocess.DEVNULL, timeout=1)
        win = json.loads(raw.decode())
        addr = win.get("address")
    except Exception:
        addr = None

    if addr:
        subprocess.run(["hyprctl", "dispatch", "closewindow", f"address:{addr}"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    else:
        subprocess.run(["hyprctl", "dispatch", "killactive"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

if __name__ == "__main__":
    kill_clean()
