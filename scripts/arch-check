#!/usr/bin/env python3
"""
arch-check: Interactive TUI & CLI Package Update Manager for Arch Linux / CachyOS.
Allows selecting which applications/packages to update via an interactive TUI checklist.
"""

from __future__ import annotations

import argparse
import curses
import os
import re
import shutil
import subprocess
import sys
from concurrent.futures import ThreadPoolExecutor
from dataclasses import dataclass, field
from pathlib import Path

# ANSI colors for non-TUI output
RESET = "\033[0m"
BOLD = "\033[1m"
DIM = "\033[2m"
RED = "\033[31m"
GREEN = "\033[32m"
YELLOW = "\033[33m"
BLUE = "\033[34m"
MAGENTA = "\033[35m"
CYAN = "\033[36m"
WHITE = "\033[37m"

COMMON_APPS_HINTS = {
    "code", "visual-studio-code", "antigravity", "zen-browser", "firefox", "chromium",
    "google-chrome", "brave-bin", "telegram", "discord", "spotify", "localsend",
    "gimp", "inkscape", "blender", "vlc", "mpv", "obs-studio", "kitty", "alacritty",
    "wezterm", "foot", "btop", "htop", "nvtop", "fish",
    "zsh", "tmux", "zellij", "git", "github-cli", "docker", "docker-compose",
    "lazygit", "neovim", "helix", "micro", "nautilus", "thunar", "dolphin",
    "libreoffice", "wps-office", "obsidian", "postman", "dbeaver", "gpu-screen-recorder",
    "fcitx5", "fcitx5-bamboo", "fcitx5-configtool", "fuzzel", "rofi", "wofi", "waybar",
    "flatpak", "brightnessctl", "pavucontrol", "7zip", "yazi"
}

EXCLUDED_FROM_APPS = {
    "fastfetch", "neofetch", "hyprland", "hypridle", "hyprpicker", "hyprpaper",
    "hyprlock", "hyprtoolkit", "hyprglass", "hypr-dynamic-cursors", "imgborders",
    "ryoku", "ryoku-shell", "ryoku-desktop", "ryoku-hub", "ryoku-rashin",
    "ryoku-hypr-plugins", "ryoku-cursors", "ryoku-blobs", "xdg-desktop-portal-hyprland"
}

SYSTEM_LIB_PREFIXES = (
    "lib", "glibc", "gcc", "clang", "llvm", "boost", "qt5", "qt6", "gtk", "pango",
    "cairo", "gstreamer", "gst-", "mesa", "vulkan", "pipewire", "wireplumber",
    "alsa-", "systemd", "udev", "wayland", "xorg-", "xcb", "icu", "openssl", "gnutls",
    "python-", "perl-", "ruby-", "lua-", "haskell-", "nodejs-", "npm-", "bpf"
)

@dataclass
class PkgUpdate:
    name: str
    old_version: str
    new_version: str
    source: str  # "Repo" or "AUR"
    is_app: bool = False
    is_kernel: bool = False
    selected: bool = False

def get_ignored_packages() -> set[str]:
    ignored = set()
    pacman_conf = Path("/etc/pacman.conf")
    if pacman_conf.exists():
        try:
            for line in pacman_conf.read_text().splitlines():
                line = line.strip()
                if line.startswith("IgnorePkg") and "=" in line:
                    _, _, pkgs = line.partition("=")
                    for p in pkgs.split():
                        ignored.add(p.strip())
        except Exception:
            pass
    return ignored

def is_user_app(name: str) -> bool:
    lname = name.lower()
    clean_name = re.sub(r"(-bin|-git|-appimage|-gtk)$", "", lname)
    if clean_name in EXCLUDED_FROM_APPS or lname in EXCLUDED_FROM_APPS:
        return False
    if clean_name in COMMON_APPS_HINTS or lname in COMMON_APPS_HINTS:
        return True
    if any(lname.startswith(p) for p in ("visual-studio", "zen-", "google-", "firefox-", "telegram-", "discord-", "fcitx5-")):
        return True
    if any(lname.startswith(p) for p in SYSTEM_LIB_PREFIXES):
        return False
    if Path(f"/usr/share/applications/{name}.desktop").exists() or Path(f"/usr/share/applications/{clean_name}.desktop").exists():
        return True
    return False

def scan_repo_updates() -> list[PkgUpdate]:
    updates = []
    try:
        res = subprocess.run(["checkupdates"], capture_output=True, text=True, check=False)
        for line in res.stdout.splitlines():
            line = line.strip()
            if not line:
                continue
            m = re.match(r"^(\S+)\s+(\S+)\s+->\s+(\S+)", line)
            if m:
                pkg_name, old_ver, new_ver = m.groups()
                is_k = "linux" in pkg_name or "kernel" in pkg_name or pkg_name.startswith("linux-")
                is_app = is_user_app(pkg_name)
                updates.append(PkgUpdate(pkg_name, old_ver, new_ver, "Repo", is_app=is_app, is_kernel=is_k, selected=is_app))
    except Exception:
        pass
    return updates

def scan_aur_updates() -> list[PkgUpdate]:
    updates = []
    helper = shutil.which("yay") or shutil.which("paru")
    if not helper:
        return updates
    try:
        res = subprocess.run([helper, "-Qua"], capture_output=True, text=True, check=False)
        for line in res.stdout.splitlines():
            line = line.strip()
            if not line:
                continue
            m = re.match(r"^(\S+)\s+(\S+)\s+->\s+(\S+)", line)
            if m:
                pkg_name, old_ver, new_ver = m.groups()
                is_k = "linux" in pkg_name or "kernel" in pkg_name
                is_app = is_user_app(pkg_name)
                updates.append(PkgUpdate(pkg_name, old_ver, new_ver, "AUR", is_app=is_app, is_kernel=is_k, selected=is_app))
    except Exception:
        pass
    return updates

class UpdateTUI:
    def __init__(self, all_updates: list[PkgUpdate], default_tab: int = 0):
        self.all_updates = all_updates
        self.tabs = [
            ("User Apps", [u for u in all_updates if u.is_app]),
            ("AUR Packages", [u for u in all_updates if u.source == "AUR" and not u.is_app]),
            ("System & Libs", [u for u in all_updates if not u.is_app and not u.is_kernel]),
            ("All Updates", all_updates),
        ]
        self.active_tab = default_tab if 0 <= default_tab < len(self.tabs) else 0
        self.cursor = 0
        self.scroll_offset = 0
        self.search_query = ""
        self.searching = False

    def get_current_items(self) -> list[PkgUpdate]:
        items = self.tabs[self.active_tab][1]
        if not self.search_query:
            return items
        q = self.search_query.lower()
        return [u for u in items if q in u.name.lower()]

    def run(self, stdscr) -> list[str]:
        curses.curs_set(0)
        curses.use_default_colors()
        stdscr.timeout(50)

        # Color pairs
        curses.init_pair(1, curses.COLOR_CYAN, -1)     # Cyan
        curses.init_pair(2, curses.COLOR_GREEN, -1)    # Green
        curses.init_pair(3, curses.COLOR_MAGENTA, -1)  # Magenta
        curses.init_pair(4, curses.COLOR_RED, -1)      # Red
        curses.init_pair(5, curses.COLOR_YELLOW, -1)   # Yellow
        curses.init_pair(6, curses.COLOR_BLACK, curses.COLOR_CYAN)  # Selected tab / active highlight
        curses.init_pair(7, curses.COLOR_WHITE, curses.COLOR_BLUE)  # Status bar

        while True:
            stdscr.erase()
            h, w = stdscr.getmaxyx()
            if h < 10 or w < 40:
                stdscr.addstr(0, 0, "Terminal too small!")
                stdscr.refresh()
                key = stdscr.getch()
                if key in (ord('q'), 27):
                    return []
                continue

            # 1. Header
            header = " Arch Update Manager "
            total_sel = sum(1 for u in self.all_updates if u.selected)
            info = f" {len(self.all_updates)} available, {total_sel} selected "
            stdscr.addstr(0, 1, header, curses.A_BOLD | curses.color_pair(1))
            if w > len(header) + len(info) + 4:
                stdscr.addstr(0, w - len(info) - 2, info, curses.color_pair(2))

            # 2. Tabs
            tab_x = 2
            for i, (name, pkg_list) in enumerate(self.tabs):
                sel_count = sum(1 for u in pkg_list if u.selected)
                label = f" [{i+1}] {name} ({sel_count}/{len(pkg_list)}) "
                if tab_x + len(label) < w - 2:
                    if i == self.active_tab:
                        stdscr.addstr(2, tab_x, label, curses.color_pair(6) | curses.A_BOLD)
                    else:
                        stdscr.addstr(2, tab_x, label, curses.A_DIM)
                    tab_x += len(label) + 1

            # 3. Search Bar
            if self.searching or self.search_query:
                prefix = " Search: "
                stdscr.addstr(3, 2, prefix, curses.color_pair(5) | curses.A_BOLD)
                query_str = self.search_query + ("█" if self.searching else "")
                stdscr.addstr(3, 2 + len(prefix), query_str[:w - 15], curses.A_UNDERLINE)

            # 4. Item List
            items = self.get_current_items()
            list_top = 5 if (self.searching or self.search_query) else 4
            list_height = h - list_top - 3

            if self.cursor >= len(items):
                self.cursor = max(0, len(items) - 1)
            if self.cursor < self.scroll_offset:
                self.scroll_offset = self.cursor
            elif self.cursor >= self.scroll_offset + list_height:
                self.scroll_offset = self.cursor - list_height + 1

            visible_items = items[self.scroll_offset:self.scroll_offset + list_height]

            # List Header
            hdr = f"  {'SRC':<6} {'PACKAGE NAME':<26} {'CURRENT':<16} {'AVAILABLE'}"
            stdscr.addstr(list_top - 1, 2, hdr[:w - 4], curses.A_DIM)

            for idx, item in enumerate(visible_items):
                real_idx = self.scroll_offset + idx
                row = list_top + idx
                is_cur = (real_idx == self.cursor)

                chk = "[x]" if item.selected else "[ ]"
                src_tag = "aur " if item.source == "AUR" else "core"
                src_color = curses.color_pair(3) if item.source == "AUR" else curses.color_pair(1)

                name_str = item.name[:24]
                old_v = item.old_version[:14]
                new_v = item.new_version[:14]

                if is_cur:
                    stdscr.addstr(row, 1, ">", curses.A_BOLD | curses.color_pair(2))
                    attr = curses.A_BOLD | curses.A_REVERSE
                else:
                    attr = curses.A_NORMAL

                stdscr.addstr(row, 3, chk, curses.color_pair(2) if item.selected else curses.A_DIM)
                stdscr.addstr(row, 7, f"[{src_tag}]", src_color)
                stdscr.addstr(row, 14, f"{name_str:<26}", attr if is_cur else curses.A_BOLD)
                stdscr.addstr(row, 41, f"{old_v:<16}", curses.color_pair(4) if not is_cur else attr)
                stdscr.addstr(row, 58, "-> ", curses.A_DIM)
                stdscr.addstr(row, 61, f"{new_v}", curses.color_pair(2) if not is_cur else attr)

            if not items:
                stdscr.addstr(list_top + 2, 4, "(No updates in this view)", curses.A_DIM)

            # 5. Bottom Status / Help Bar
            bar_text = f" [Space] Toggle  [a] All  [Tab] Category  [/] Search  [Enter] Update ({total_sel})  [q] Quit "
            stdscr.addstr(h - 2, 0, bar_text.ljust(w - 1)[:w - 1], curses.color_pair(7))

            stdscr.refresh()

            # Handle Input
            key = stdscr.getch()
            if key == -1:
                continue

            if self.searching:
                if key in (10, 13, 27):  # Enter or Esc
                    self.searching = False
                elif key in (curses.KEY_BACKSPACE, 127, 8):
                    self.search_query = self.search_query[:-1]
                elif 32 <= key <= 126:
                    self.search_query += chr(key)
                continue

            if key in (ord('q'), ord('Q')):
                return []
            elif key == 27:  # Esc
                if self.search_query:
                    self.search_query = ""
                else:
                    return []
            elif key in (curses.KEY_UP, ord('k')):
                self.cursor = max(0, self.cursor - 1)
            elif key in (curses.KEY_DOWN, ord('j')):
                self.cursor = min(len(items) - 1, self.cursor + 1)
            elif key in (curses.KEY_PPAGE,):  # Page Up
                self.cursor = max(0, self.cursor - 10)
            elif key in (curses.KEY_NPAGE,):  # Page Down
                self.cursor = min(len(items) - 1, self.cursor + 10)
            elif key == ord(' '):  # Space toggle
                if items:
                    items[self.cursor].selected = not items[self.cursor].selected
            elif key in (ord('a'), ord('A')):  # Toggle all in view
                if items:
                    any_unselected = any(not u.selected for u in items)
                    for u in items:
                        u.selected = any_unselected
            elif key == ord('\t'):  # Tab
                self.active_tab = (self.active_tab + 1) % len(self.tabs)
                self.cursor = 0
                self.scroll_offset = 0
            elif key in (ord('1'), ord('2'), ord('3'), ord('4')):
                tab_idx = key - ord('1')
                if 0 <= tab_idx < len(self.tabs):
                    self.active_tab = tab_idx
                    self.cursor = 0
                    self.scroll_offset = 0
            elif key == ord('/'):
                self.searching = True
            elif key in (10, 13, curses.KEY_ENTER):  # Enter confirm
                selected = [u.name for u in self.all_updates if u.selected]
                return selected

def execute_update(pkg_names: list[str]):
    if not pkg_names:
        print(f"{YELLOW}==> No packages selected for update.{RESET}")
        return

    helper = shutil.which("yay") or shutil.which("paru") or "sudo pacman"
    print(f"{BOLD}{BLUE}:: Updating {len(pkg_names)} package(s):{RESET}")
    for name in pkg_names:
        print(f"   {BOLD}{name}{RESET}")
    print()

    cmd = [helper, "-S"]
    if "yay" in helper or "paru" in helper:
        cmd += ["--nodiffmenu", "--nocleanmenu", "--noeditmenu", "--answerclean", "None", "--answerdiff", "None"]
    cmd += pkg_names
    os.execvp(helper, cmd)

def main():
    parser = argparse.ArgumentParser(
        description="Selective package update inspector and safe application updater with TUI."
    )
    parser.add_argument("--apps", "-a", action="store_true", help="Show only user application updates")
    parser.add_argument("--aur", action="store_true", help="Show only AUR updates")
    parser.add_argument("--list", "-l", action="store_true", help="Print plain list without launching TUI")
    parser.add_argument("--update", "-u", metavar="PKG", help="Directly update a specific package")
    parser.add_argument(
        "--update-apps", "-ua", "-U", action="store_true",
        help="Update user applications directly or launch app-focused TUI"
    )
    parser.add_argument("--no-tui", action="store_true", help="Do not launch interactive TUI")
    args = parser.parse_args()

    if args.update:
        pkg = args.update
        helper = shutil.which("yay") or shutil.which("paru") or "sudo pacman"
        cmd = [helper, "-S"]
        if "yay" in helper or "paru" in helper:
            cmd += ["--nodiffmenu", "--nocleanmenu", "--noeditmenu", "--answerclean", "None", "--answerdiff", "None"]
        cmd.append(pkg)
        os.execvp(helper, cmd)
        return

    # Check terminal TTY
    is_tty = sys.stdin.isatty() and sys.stdout.isatty()

    print(f"{DIM}Scanning for available updates...{RESET}", end="\r", flush=True)

    with ThreadPoolExecutor(max_workers=2) as ex:
        f_repo = ex.submit(scan_repo_updates)
        f_aur = ex.submit(scan_aur_updates)
        repo_updates = f_repo.result()
        aur_updates = f_aur.result()

    all_updates = repo_updates + aur_updates
    apps = [u for u in all_updates if u.is_app]

    # Clear scanning line
    print(" " * 40, end="\r", flush=True)

    if not all_updates:
        print(f"{GREEN}==> System is fully up to date (0 updates available).{RESET}")
        return

    # Direct non-interactive update if requested
    if args.update_apps and (args.no_tui or not is_tty):
        execute_update([a.name for a in apps])
        return

    # Plain list mode
    if args.list or args.no_tui or not is_tty:
        ignored_pkgs = get_ignored_packages()
        aur_only = [u for u in all_updates if u.source == "AUR"]
        system_libs = [u for u in all_updates if not u.is_app and not u.is_kernel]
        kernels = [u for u in all_updates if u.is_kernel]

        def print_section(title: str, color: str, items: list[PkgUpdate]):
            if not items:
                return
            print(f"{BOLD}{color}:: {title} ({len(items)}){RESET}")
            max_name_len = max(len(u.name) for u in items)
            max_name_len = min(max(max_name_len + 2, 24), 36)

            for u in items:
                tag = f"{MAGENTA}aur{RESET}" if u.source == "AUR" else f"{BLUE}core{RESET}"
                is_held = u.name in ignored_pkgs or any(u.name.startswith(p.replace("*", "")) for p in ignored_pkgs)
                held_tag = f" {YELLOW}[held]{RESET}" if is_held else ""

                name_fmt = f"{BOLD}{u.name:<{max_name_len}}{RESET}"
                ver_fmt = f"{RED}{u.old_version}{RESET} -> {GREEN}{u.new_version}{RESET}"
                print(f"   [{tag}] {name_fmt} {ver_fmt}{held_tag}")
            print()

        if not args.apps and not args.aur:
            print_section("User Applications", CYAN, apps)
            print_section("AUR Packages", MAGENTA, [u for u in aur_only if not u.is_app])
            print_section("System & Libraries", BLUE, system_libs)
            if kernels:
                print_section("Protected Kernel Packages", YELLOW, kernels)
        elif args.apps:
            print_section("User Applications", CYAN, apps)
        elif args.aur:
            print_section("AUR Packages", MAGENTA, aur_only)

        print(f"{DIM}{'─' * 60}{RESET}")
        print(
            f"{BOLD}Total:{RESET} {GREEN}{len(all_updates)}{RESET} updates "
            f"({CYAN}{len(apps)}{RESET} apps, {MAGENTA}{len(aur_updates)}{RESET} AUR, {BLUE}{len(system_libs)}{RESET} system)."
        )
        print(f"{DIM}Run 'arch-check' to open interactive selection TUI.{RESET}\n")
        return

    # Launch Interactive TUI by default
    initial_tab = 0 if (args.apps or args.update_apps) else (1 if args.aur else 0)
    tui = UpdateTUI(all_updates, default_tab=initial_tab)
    selected_pkgs = curses.wrapper(tui.run)

    if selected_pkgs:
        execute_update(selected_pkgs)
    else:
        print(f"{YELLOW}==> Update cancelled.{RESET}")

if __name__ == "__main__":
    main()
