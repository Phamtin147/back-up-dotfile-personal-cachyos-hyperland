#!/usr/bin/env bash
# Smart 50% <-> 100% Column Toggle for Hyprland Scrolling

WIN_INFO=$(hyprctl activewindow -j 2>/dev/null)
if [ -z "$WIN_INFO" ] || [ "$WIN_INFO" = "{}" ]; then exit 0; fi

WIN_W=$(echo "$WIN_INFO" | jq -r '.size[0] // 0')
MON_ID=$(echo "$WIN_INFO" | jq -r '.monitor // 0')
MON_W=$(hyprctl monitors -j 2>/dev/null | jq -r ".[] | select(.id == $MON_ID) | .width // 1920")

# If window occupies more than 65% of screen width, shrink to 50%
if [ "$WIN_W" -gt "$((MON_W * 65 / 100))" ]; then
    hyprctl eval 'hl.dispatch(hl.dsp.layout("colresize -conf"))' >/dev/null 2>&1
else
    hyprctl eval 'hl.dispatch(hl.dsp.layout("colresize +conf"))' >/dev/null 2>&1
fi
