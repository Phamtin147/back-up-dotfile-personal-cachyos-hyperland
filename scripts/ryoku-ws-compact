#!/usr/bin/env python3
import socket
import os
import sys
import json
import subprocess
import time
import threading

def get_hypr_socket():
    his = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    xdg = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    if his:
        path = f"{xdg}/hypr/{his}/.socket2.sock"
        if os.path.exists(path):
            return path
    hypr_dir = f"{xdg}/hypr"
    if os.path.exists(hypr_dir):
        for entry in os.listdir(hypr_dir):
            cand = f"{hypr_dir}/{entry}/.socket2.sock"
            if os.path.exists(cand):
                return cand
    return None

def get_json(cmd):
    try:
        out = subprocess.check_output(cmd, stderr=subprocess.DEVNULL, timeout=2)
        return json.loads(out.decode())
    except Exception:
        return []

def compact():
    monitors = get_json(["hyprctl", "monitors", "-j"])
    clients = get_json(["hyprctl", "clients", "-j"])
    if not monitors:
        return

    batch_cmds = []

    for mon in monitors:
        m_id = mon["id"]
        is_focused = mon.get("focused", False)
        base = m_id * 500
        min_ws = base + 1
        max_ws = base + 500

        # Find all windows on this SPECIFIC monitor strictly by monitor ID
        mon_clients = [c for c in clients if c.get("monitor", -1) == m_id]
        
        # Unique occupied workspace IDs sorted
        occupied_ws_ids = sorted(list(set(c["workspace"]["id"] for c in mon_clients)))
        
        ws_remap = {}
        for i, ws_id in enumerate(occupied_ws_ids):
            target_id = min_ws + i
            if ws_id != target_id:
                ws_remap[ws_id] = target_id

        cur_active_id = mon.get("activeWorkspace", {}).get("id", min_ws)

        # Move windows according to ws_remap (strictly staying within THIS monitor)
        if ws_remap:
            for old_ws in sorted(ws_remap.keys()):
                new_ws = ws_remap[old_ws]
                ws_wins = [c for c in mon_clients if c["workspace"]["id"] == old_ws]
                for c in ws_wins:
                    addr = c["address"]
                    batch_cmds.append(f"hl.dsp.window.move({{ workspace = {new_ws}, window = 'address:{addr}' }})")

            # ONLY update active workspace focus if this monitor is currently FOCUSED
            if is_focused:
                if cur_active_id in ws_remap:
                    new_active = ws_remap[cur_active_id]
                    batch_cmds.append(f"hl.dsp.focus({{ workspace = {new_active} }})")
                elif occupied_ws_ids:
                    max_new_ws = min_ws + len(occupied_ws_ids) - 1
                    if cur_active_id > max_new_ws + 1:
                        new_trailing = max_new_ws + 1
                        batch_cmds.append(f"hl.dsp.focus({{ workspace = {new_trailing} }})")

    if batch_cmds:
        for cmd in batch_cmds:
            subprocess.run(["hyprctl", "dispatch", cmd], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

class Debouncer:
    def __init__(self, delay, callback):
        self.delay = delay
        self.callback = callback
        self.timer = None
        self.lock = threading.Lock()

    def trigger(self):
        with self.lock:
            if self.timer is not None:
                self.timer.cancel()
            self.timer = threading.Timer(self.delay, self._run)
            self.timer.start()

    def _run(self):
        try:
            self.callback()
        except Exception:
            pass

def run_daemon():
    compact()
    debouncer = Debouncer(0.08, compact)
    
    while True:
        sock_path = get_hypr_socket()
        if not sock_path:
            time.sleep(1)
            continue
        try:
            client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            client.connect(sock_path)
            buffer = ""
            while True:
                data = client.recv(4096)
                if not data:
                    break
                buffer += data.decode("utf-8", errors="ignore")
                while "\n" in buffer:
                    line, buffer = buffer.split("\n", 1)
                    line = line.strip()
                    if not line:
                        continue
                    event_name = line.split(">>")[0]
                    if event_name in ("closewindow", "movewindow", "destroyworkspace", "movewindowv2"):
                        debouncer.trigger()
        except Exception:
            time.sleep(0.5)

if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] in ("--once", "-1", "compact"):
        compact()
    else:
        run_daemon()
