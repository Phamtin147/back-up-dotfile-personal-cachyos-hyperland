#!/usr/bin/env python3
import os
import sys
import time
import json
import socket
import select
import subprocess
import evdev

COOLDOWN = 0.5
EDGE_THRESHOLD = 6
DWELL_TIME = 0.12

def get_hypr_socket():
    rundir = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")
    if not sig:
        return None
    return f"{rundir}/hypr/{sig}/.socket.sock"

def query_hypr(sock_path, cmd):
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(0.1)
        s.connect(sock_path)
        s.sendall(cmd.encode())
        res = b""
        while True:
            chunk = s.recv(4096)
            if not chunk:
                break
            res += chunk
        s.close()
        return res.decode(errors="ignore")
    except Exception:
        return None

def get_screen_bounds(sock_path):
    res = query_hypr(sock_path, "j/monitors")
    if not res:
        return 1536
    try:
        monitors = json.loads(res)
        for m in monitors:
            if m.get("focused", False):
                scale = m.get("scale", 1.0)
                width = m.get("width", 1920)
                return int(width / scale)
    except Exception:
        pass
    return 1536

def get_cursor_pos(sock_path):
    res = query_hypr(sock_path, "j/cursorpos")
    if not res:
        return None, None
    try:
        data = json.loads(res)
        return data.get("x"), data.get("y")
    except Exception:
        return None, None

def find_pointer_devices():
    devs = []
    for path in evdev.list_devices():
        try:
            d = evdev.InputDevice(path)
            caps = d.capabilities()
            if evdev.ecodes.EV_KEY in caps and evdev.ecodes.BTN_LEFT in caps[evdev.ecodes.EV_KEY]:
                devs.append(d)
        except Exception:
            pass
    return devs

def main():
    sock_path = get_hypr_socket()
    if not sock_path or not os.path.exists(sock_path):
        sys.exit(1)

    screen_width = get_screen_bounds(sock_path)
    devices = find_pointer_devices()
    if not devices:
        sys.exit(1)

    pressed_devices = set()
    last_scroll_time = 0.0
    edge_enter_time = 0.0
    pending_edge = None
    last_device_scan = time.time()

    while True:
        now = time.time()
        if now - last_device_scan > 5.0:
            devices = find_pointer_devices()
            last_device_scan = now
            screen_width = get_screen_bounds(sock_path)

        timeout = 0.04 if pressed_devices else 0.5
        r, _, _ = select.select(devices, [], [], timeout)

        for dev in r:
            try:
                for ev in dev.read():
                    if ev.type == evdev.ecodes.EV_KEY and ev.code == evdev.ecodes.BTN_LEFT:
                        if ev.value == 1:
                            pressed_devices.add(dev.path)
                        elif ev.value == 0:
                            pressed_devices.discard(dev.path)
                            pending_edge = None
            except Exception:
                devices = find_pointer_devices()

        if pressed_devices:
            cx, cy = get_cursor_pos(sock_path)
            if cx is not None:
                current_edge = None
                if cx >= screen_width - EDGE_THRESHOLD:
                    current_edge = "right"
                elif cx <= EDGE_THRESHOLD:
                    current_edge = "left"

                if current_edge:
                    if pending_edge == current_edge:
                        if (now - edge_enter_time >= DWELL_TIME) and (now - last_scroll_time >= COOLDOWN):
                            nav_script = os.path.expanduser("~/.local/bin/ryoku-col-nav")
                            subprocess.run([nav_script, current_edge], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                            last_scroll_time = now
                            pending_edge = None
                    else:
                        pending_edge = current_edge
                        edge_enter_time = now
                else:
                    pending_edge = None
        else:
            pending_edge = None

if __name__ == "__main__":
    main()
