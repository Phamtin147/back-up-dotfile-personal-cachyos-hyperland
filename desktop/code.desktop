[Desktop Entry]
Name=Visual Studio Code
Comment=Code Editing. Redefined.
GenericName=Text Editor
Exec=code %F
Icon=vscode
Type=Application
StartupNotify=false
StartupWMClass=Code
Categories=TextEditor;Development;IDE;
MimeType=application/x-code-workspace;text/plain;text/markdown;text/x-markdown;application/json;text/xml;application/xml;text/x-shellscript;application/x-shellscript;text/x-python;text/x-lua;text/css;text/x-csrc;text/x-chdr;text/x-c++src;text/x-c++hdr;text/x-go;application/toml;text/x-toml;application/x-yaml;text/yaml;text/x-rust;text/x-java;text/javascript;application/javascript;text/typescript;application/typescript;text/x-qml;text/x-log;text/x-diff;text/x-patch;text/x-readme;application/sql;text/x-sql;application/x-zerosize;
Actions=new-empty-window;
Keywords=vscode;

[Desktop Action new-empty-window]
Name=New Empty Window
Name[cs]=Nové prázdné okno
Name[de]=Neues leeres Fenster
Name[es]=Nueva ventana vacía
Name[fr]=Nouvelle fenêtre vide
Name[it]=Nuova finestra vuota
Name[ja]=新しい空のウィンドウ
Name[ko]=새 빈 창
Name[ru]=Новое пустое окно
Name[zh_CN]=新建空窗口
Name[zh_TW]=開新空視窗
